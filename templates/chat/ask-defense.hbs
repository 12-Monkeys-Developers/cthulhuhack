<div class="cthack ask-roll ask-defense">
  <h4 class="ask-roll-title">{{text}}</h4>
  <div class="ask-roll-subtitle">{{localize "CTHACK.Defense.saveToMake" save=saveText}}</div>
  <a class="ask-defense-dice" data-actor-uuid="{{victim.uuid}}" data-opponent-token-uuid="{{opponent.tokenUuid}}" data-attack-id="{{attack.id}}" data-save="{{save}}" data-avantage="{{avantage}}">
    <i class="fas fa-shield-halved"></i> {{localize "CTHACK.Defense.defend"}}
  </a>
</div>
