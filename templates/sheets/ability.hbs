{{!log "Cthulhu Hack | ability" this}}
<section class="ability-section">

  <div class="item-header">
      <input name="name" type="text" value="{{item.name}}"{{#if locked}} disabled{{/if}} />
      <div class="item-header-row">
          <div class="item-image">
              {{#if unlocked}}
                  <img class="editable-image" data-action="editImage" data-uuid="{{item.uuid}}" src="{{item.img}}" data-edit="img" data-tooltip="{{localize 'TOOLTIPS.SelectImage'}}" />
              {{else}}
                  {{#unless hasDefaultImage}}
                      <img src="{{item.img}}" />
                  {{/unless}}                        
              {{/if}}
          </div>
      </div>
  </div>

  {{#if unlocked}}
    <fieldset class="ability-group">
      <legend>{{localize "CTHACK.AbilitySettings"}}</legend>
      <div class="item-properties grid-3">
        {{#if system.isCustom}}{{formGroup systemFields.key value=systemSource.key localize=true disabled=true}}{{else}}{{formGroup systemFields.key value=systemSource.key name="system.key" localize=true}}{{/if}}
        {{formGroup systemFields.isCustom value=systemSource.isCustom name="system.isCustom" localize=true}}
        {{formGroup systemFields.multiple value=systemSource.multiple name="system.multiple" localize=true}}
      </div>
    </fieldset>

    <fieldset class="ability-group">
      <legend>{{localize "CTHACK.AbilityUses"}}</legend>
      <div class="item-properties grid-3">
        {{formGroup systemFields.uses.fields.per value=systemSource.uses.per name="system.uses.per" localize=true}}
        {{#if system.hasUse}}
          {{formGroup systemFields.uses.fields.max value=systemSource.uses.max name="system.uses.max" localize=true}}
          {{formGroup systemFields.uses.fields.value value=systemSource.uses.value name="system.uses.value" localize=true}}
        {{/if}}
      </div>
      {{#if system.hasLastUse}}
        <div class="ability-summary-line">{{localize "CTHACK.AbilityUseLast"}} : {{system.uses.last}}</div>
      {{/if}}
    </fieldset>

    <fieldset class="ability-group">
      <legend>{{localize "CTHACK.Advantage"}}</legend>
      <div class="item-properties grid-3">
        {{formGroup systemFields.advantageGiven value=systemSource.advantageGiven name="system.advantageGiven" localize=true}}
      </div>
      {{#if system.advantageGiven}}
        <div class="ability-advantage-text">
          {{formGroup systemFields.advantageText value=systemSource.advantageText name="system.advantageText" localize=true}}
        </div>
      {{/if}}
    </fieldset>
  {{else}}
    <div class="ability-summary">
      {{#if system.hasUse}}
        <div class="ability-summary-line">{{localize "CTHACK.AbilityUseValue"}} ({{abilityPeriodToString system.uses.per}}) : {{system.uses.value}}/{{system.uses.max}}</div>
      {{/if}}
      {{#if system.hasLastUse}}
        <div class="ability-summary-line">{{localize "CTHACK.AbilityUseLast"}} : {{system.uses.last}}</div>
      {{/if}}
      {{#if hasAdvantage}}
        <div class="ability-summary-line">{{localize "CTHACK.Advantage"}} : {{system.advantageText}}</div>
      {{/if}}
    </div>
  {{/if}}

  <div class="item-description">
    {{#if unlocked}}
      <fieldset>
        <legend>{{localize "CTHACK.Description"}}</legend>
        <div class="description-content">
          {{formInput systemFields.description enriched=enrichedDescription value=system.description name="system.description" toggled=true}}
        </div>
      </fieldset>
    {{else}}
      {{#if system.hasDescription}}
        <fieldset>
          <legend>{{localize "CTHACK.Description"}}</legend>
          <div class="description-content">
            {{formInput systemFields.description enriched=enrichedDescription value=system.description name="system.description" toggled=true}}
          </div>
        </fieldset>
      {{/if}}
    {{/if}}
  </div>
</section>